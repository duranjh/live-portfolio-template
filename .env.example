# ─────────────────────────────────────────────────────────────────────────────
# Live Portfolio — environment (NAMES ONLY; never commit real values).
# Copy to `.env.local` and fill in to enable capture. With NONE of these set, the
# app runs in DEMO MODE (forms validate + show success, nothing is stored/sent).
#
# Capture is ALL-OR-NOTHING: if you set any of the database/email keys, you must
# set the FULL set below or the app throws at startup (no silent half-run).
# ─────────────────────────────────────────────────────────────────────────────

# Force demo mode even if other keys are present (handy for previews).
# DEMO=true

# ── Database — Supabase Postgres (list + idea board) ─────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # server-only secret — NEVER expose as NEXT_PUBLIC_*

# ── Email — Resend (double opt-in + broadcast) ───────────────────────────────
RESEND_API_KEY=
MAIL_FROM=                   # RFC 5322 from-address, e.g. "Jane <hello@example.com>"
OWNER_EMAIL=                 # where owner notifications (new ideas, etc.) are sent
RESEND_WEBHOOK_SECRET=       # Svix signing secret for the Resend bounce/complaint webhook

# ── Site ─────────────────────────────────────────────────────────────────────
SITE_URL=                    # canonical origin, e.g. https://example.com (links + origin checks)

# ── Bot defense — Cloudflare Turnstile ───────────────────────────────────────
TURNSTILE_SECRET_KEY=                 # verified server-side
NEXT_PUBLIC_TURNSTILE_SITE_KEY=       # the ONLY public (client-visible) key

# ── Security ─────────────────────────────────────────────────────────────────
IP_HMAC_KEY=                 # random secret; IPs/emails stored only as keyed HMACs, never raw

# ── Admin / broadcast (optional) ─────────────────────────────────────────────
# Admin + broadcast routes return 503 until one auth path is configured.
# ADMIN_SECRET=              # Bearer token for machine/cron admin calls (constant-time compared)
# CF_ACCESS_TEAM_DOMAIN=     # e.g. yourteam.cloudflareaccess.com (human admin via Cloudflare Access)
# CF_ACCESS_AUD=             # the Cloudflare Access application audience (AUD) tag

# ── Analytics (optional, cookieless, off by default) ─────────────────────────
# Add your provider's snippet/env here (Plausible / Umami / Vercel). Unset = no script, no banner.
